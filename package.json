{
  "name": "oneslash-design-system",
  "description": "A design system for the Oneslash projects",
  "version": "2.0.1",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.jsx"
    },
    "./tokens": {
      "types": "./dist/designTokens.d.ts",
      "default": "./dist/designTokens.js"
    },
    "./themes/*": "./dist/themes/*",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./theme-auto.css": "./dist/theme-auto.css",
    "./typography.css": "./dist/typography.css",
    "./tailwind": "./dist/tailwind-preset.js",
    "./tailwind-auto": "./dist/tailwind-preset-auto.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "build:tokens": "node scripts/build-tokens.js",
    "build": "npm run build:tokens && tsc",
    "watch": "tsc --watch",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pretest": "npm run build",
    "test": "node --test scripts/*.test.js scripts/tokens/*.test.js",
    "check:contrast": "node scripts/check-contrast.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "lucide-react": "^0.577.0",
    "react-popper": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-essentials": "8.6",
    "@storybook/react-vite": "8.6",
    "@types/node": "20.16.10",
    "@types/react": "18.3.10",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.13",
    "http-server": "14.1.1",
    "next": "14.2.13",
    "postcss": "^8",
    "postcss-cli": "^11.0.0",
    "react": "^18",
    "react-dom": "^18",
    "storybook": "8.6",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.6.2",
    "vite": "^5.4.21"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneSlash-app/design-system.git"
  }
}
